# Copie para .env.local (desenvolvimento) e cole também nas variáveis de
# ambiente da Vercel. Os dois valores estão no painel do Supabase, em
# Project Settings -> API.
#
# Atenção: por começarem com NEXT_PUBLIC_, estas variáveis são embutidas no
# build. Se você mudar alguma na Vercel, faça um novo deploy para valer.

# Project URL, algo como https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave "anon public" -- pode ficar no navegador: quem protege os dados é a
# RLS configurada em supabase/migrations/0001_init.sql, não o segredo da chave.
# NUNCA use aqui a chave "service_role".
NEXT_PUBLIC_SUPABASE_ANON_KEY=
